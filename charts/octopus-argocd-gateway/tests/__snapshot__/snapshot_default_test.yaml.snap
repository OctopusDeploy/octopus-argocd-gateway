should match snapshot for default values:
  1: |
    raw: |-
      This is the official Helm chart for the Octopus Deploy Argo CD Gateway.

      You can read more on how to use this at https://octopus.com/docs
  2: |
    apiVersion: batch/v1
    kind: CronJob
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-updater
    spec:
      failedJobsHistoryLimit: 1
      jobTemplate:
        spec:
          backoffLimit: 3
          template:
            spec:
              containers:
                - command:
                    - /bin/sh
                    - -c
                    - helm upgrade --atomic --namespace "NAMESPACE" --version "*.*" --reset-then-reuse-values "RELEASE-NAME" oci://registry-1.docker.io/octopusdeploy/octopus-argocd-gateway-chart
                  env:
                    - name: HELM_CACHE_HOME
                      value: /tmp/helm/cache
                    - name: HELM_CONFIG_HOME
                      value: /tmp/helm/config
                    - name: HELM_DATA_HOME
                      value: /tmp/helm/data
                  image: docker.io/alpine/helm:3
                  imagePullPolicy: IfNotPresent
                  name: helm-update
                  securityContext:
                    allowPrivilegeEscalation: false
                    capabilities:
                      drop:
                        - ALL
                    readOnlyRootFilesystem: true
                  volumeMounts:
                    - mountPath: /tmp/helm
                      name: helm-tmp
              restartPolicy: Never
              securityContext:
                seccompProfile:
                  type: RuntimeDefault
              serviceAccountName: octopus-argocd-gateway-updater
              volumes:
                - emptyDir: {}
                  name: helm-tmp
      schedule: 0 0 * * *
      successfulJobsHistoryLimit: 1
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-updater-role
      namespace: NAMESPACE
    rules:
      - apiGroups:
          - '*'
        resources:
          - '*'
        verbs:
          - '*'
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-updater-binding
      namespace: NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: octopus-argocd-gateway-updater-role
    subjects:
      - kind: ServiceAccount
        name: octopus-argocd-gateway-updater
        namespace: NAMESPACE
  5: |
    apiVersion: v1
    automountServiceAccountToken: true
    kind: ServiceAccount
    metadata:
      annotations: null
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-updater
      namespace: NAMESPACE
  6: |
    apiVersion: v1
    kind: Secret
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-argocd-auth-secret
      namespace: NAMESPACE
    stringData:
      token: argo-auth-token
    type: Opaque
  7: |
    apiVersion: v1
    data: null
    kind: Secret
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-certificates
      namespace: NAMESPACE
  8: |
    apiVersion: v1
    data:
      octopus-argocd-gateway.yaml: |-
        argocd-server-url: "localhost:30857"
        argocd-server-plaintext: false
        argocd-server-insecure: false
        argocd-server-grpcweb: false
        argocd-server-grpcweb-root-path: ""
        octopus-grpc-url: "localhost:8443"
        octopus-grpc-plaintext: false
        octopus-grpc-pin-certificate: false
        octopus-health-check-interval: "30s"
        octopus-health-check-give-up-after: "5m"
        gateway-certificate-path: /octopus-argo-gateway
        application-event-buffer-seconds: 2
        debug: false
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-config
  9: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: octopus-argocd-gateway
      template:
        metadata:
          annotations:
            revision: "0"
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: octopus-argocd-gateway
            app.kubernetes.io/version: 4.5.6
            helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
        spec:
          containers:
            - args:
                - run
              command:
                - /gateway
              env:
                - name: OCTOPUS_ARGOCD_AUTH_TOKEN
                  valueFrom:
                    secretKeyRef:
                      key: token
                      name: octopus-argocd-gateway-argocd-auth-secret
                - name: GATEWAY_VERSION
                  value: 4.5.6
                - name: HELM_CHART_VERSION
                  value: 1.2.3
                - name: HELM_RELEASE_NAME
                  value: RELEASE-NAME
                - name: KUBERNETES_NAMESPACE
                  value: NAMESPACE
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: OCTOPUS_METRICS_PORT
                  value: "0"
              image: docker.io/octopusdeploy/octopus-argocd-gateway:v4.5.6
              imagePullPolicy: IfNotPresent
              name: octopus-argocd-gateway
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              volumeMounts:
                - mountPath: /octopus-argo-gateway
                  name: configuration-volume
                - mountPath: /tmp
                  name: tmp
          securityContext:
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: octopus-argocd-gateway
          volumes:
            - emptyDir: {}
              name: tmp
            - name: configuration-volume
              projected:
                sources:
                  - configMap:
                      name: octopus-argocd-gateway-config
                  - secret:
                      name: octopus-argocd-gateway-octopus-auth-secret
                  - secret:
                      name: octopus-argocd-gateway-certificates
  10: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-role
      namespace: NAMESPACE
    rules:
      - apiGroups:
          - ""
          - batch
        resources:
          - cronjobs
          - pods
          - pods/log
        verbs:
          - get
          - list
          - patch
      - apiGroups:
          - coordination.k8s.io
        resources:
          - leases
        verbs:
          - get
          - list
          - watch
          - create
          - update
          - patch
          - delete
  11: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway-binding
      namespace: NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: octopus-argocd-gateway-role
    subjects:
      - kind: ServiceAccount
        name: octopus-argocd-gateway
        namespace: NAMESPACE
  12: |
    apiVersion: v1
    automountServiceAccountToken: true
    kind: ServiceAccount
    metadata:
      annotations: null
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: octopus-argocd-gateway
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: octopus-argocd-gateway-chart-1.2.3
      name: octopus-argocd-gateway
      namespace: NAMESPACE
